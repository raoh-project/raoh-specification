{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/raoh-project/raoh-specification/schema/issues.schema.json",
  "title": "The issue catalogue",
  "description": "catalog/issues.json: every issue variant the forms of the decoder language give, keyed by message key.",
  "type": "object",
  "propertyNames": {"pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"},
  "additionalProperties": {
    "type": "object",
    "required": ["code", "meta"],
    "properties": {
      "code": {"type": "string", "pattern": "^[a-z_]+$"},
      "params": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]$"}, "uniqueItems": true},
      "meta": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
      "optional_meta": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
    },
    "additionalProperties": false
  }
}
